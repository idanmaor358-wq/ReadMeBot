<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Premium Look -->
    <style name="Theme.Readmebot" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        
        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Rounded corners for cards and buttons by default -->
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Readmebot.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Readmebot.Medium</item>
    </style>

    <style name="ShapeAppearance.Readmebot.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">32dp</item>
    </style>

    <style name="ShapeAppearance.Readmebot.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>
</resources>