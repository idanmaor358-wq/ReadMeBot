<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_landing">

    <fragment
        android:id="@+id/navigation_landing"
        android:name="com.example.readmebot.ui.landing.LandingFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_landing">
        <action
            android:id="@+id/action_landing_to_login"
            app:destination="@id/navigation_login" />
        <action
            android:id="@+id/action_landing_to_signup"
            app:destination="@id/navigation_signup" />
    </fragment>

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.example.readmebot.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" />

    <fragment
        android:id="@+id/navigation_signup"
        android:name="com.example.readmebot.ui.signup.SignupFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_signup" />

    <fragment
        android:id="@+id/navigation_pairing"
        android:name="com.example.readmebot.ui.pairing.PairingFragment"
        android:label="Connect"
        tools:layout="@layout/fragment_pairing" />

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.readmebot.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.readmebot.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_mood_selector"
        android:name="com.example.readmebot.ui.mood.MoodSelectorFragment"
        android:label="How are you?"
        tools:layout="@layout/fragment_mood_selector" />
</navigation>